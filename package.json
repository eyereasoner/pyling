{
  "name": "pyling-conformance",
  "private": true,
  "scripts": {
    "perf": "sh -c 'if [ -x .venv/bin/python ]; then exec .venv/bin/python tools/compare_reasoners.py \"$@\"; else exec python3 tools/compare_reasoners.py \"$@\"; fi' --",
    "perf:eyeling-examples": "npm run perf -- --suite=eyeling-examples --reasoner=pyling,eyeling,fuxi --iterations=1 --warmup=0 --max-iterations=100000 --timeout=60 --allow-failures --require-reasoner=pyling --require-reasoner=eyeling --require-reasoner=fuxi --report-dir=performance-reports/eyeling-examples --markdown",
    "perf:mobibench": "npm run perf -- --suite=owl-mobibench --mobibench-limit=0 --reasoner=pyling,fuxi,owlrl --iterations=1 --warmup=0 --max-iterations=100 --timeout=600 --allow-failures --require-reasoner=pyling --require-reasoner=fuxi --require-reasoner=owlrl --report-dir=performance-reports/owl-mobibench --markdown",
    "spec": "npm run spec-rdf12",
    "spec-rdf12": "npm run spec-rdf12-ntriples && npm run spec-rdf12-nquads && npm run spec-rdf12-turtle && npm run spec-rdf12-trig",
    "spec-rdf12-ntriples": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-n-triples/syntax/manifest.ttl -i '{ \"format\": \"n-triples\" }' -c .rdf-test-suite-cache/",
    "spec-rdf12-nquads": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-n-quads/syntax/manifest.ttl -i '{ \"format\": \"n-quads\" }' -c .rdf-test-suite-cache/",
    "spec-rdf12-turtle": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-turtle/syntax/manifest.ttl -i '{ \"format\": \"turtle\" }' -c .rdf-test-suite-cache/",
    "spec-rdf12-trig": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-trig/syntax/manifest.ttl -i '{ \"format\": \"trig\" }' -c .rdf-test-suite-cache/"
  },
  "devDependencies": {
    "rdf-test-suite": "^2.1.6"
  }
}
